# A Supabase-projekt címe, például: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Kizárólag a Vercel szerveroldali környezetében tárolható Supabase secret key.
# Böngészőbe és a Git repóba soha ne kerüljön.
SUPABASE_SECRET_KEY=

# A későbbi rajzok, képek és PDF-ek privát tárolója.
SUPABASE_STORAGE_BUCKET=hepa-private

# Opcionális. Ha meg van adva, az API csak erről a címről fogad kérést.
# Példa: https://hepa-weboldal.vercel.app
HEPA_ALLOWED_ORIGIN=

