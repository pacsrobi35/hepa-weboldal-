# Helyi Supabase Edge Function fejlesztéshez. Valódi értéket ne commitolj.

# A Supabase hosztolt környezete ezeket automatikusan biztosítja.
# A két *_KEYS érték JSON-objektum, például: {"default":"..."}
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEYS=
SUPABASE_SECRET_KEYS=

# Ideiglenes visszafelé kompatibilis tartalékok.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# E-mail-küldéshez a Supabase Edge Function Secrets részében beállítandó értékek.
RESEND_API_KEY=
QUOTE_NOTIFICATION_FROM=
QUOTE_OFFER_FROM=
QUOTE_OFFER_REPLY_TO=
